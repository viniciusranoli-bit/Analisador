# Configuração central do agente de monitoramento sintético.
# Copie para monitor.config.local.env para overrides locais (não versionado).
# Ao alterar MONITOR_SMOKE_CRON, sincronize também .github/workflows/synthetic-smoke.yml
# ou execute: python monitor/scripts/check_schedule_sync.py

# ── Reexecução periódica ─────────────────────────────────
# Expressão cron (UTC). Padrão: a cada 5 minutos.
MONITOR_SMOKE_CRON=*/5 * * * *

# ── Alvo ─────────────────────────────────────────────────
MONITOR_BASE_URL=https://analisadorlinkedin.com.br

# ── Timeouts e latência ───────────────────────────────────
MONITOR_HTTP_TIMEOUT_SECONDS=15
MONITOR_L1_MAX_LATENCY_MS=10000

# ── Retentativas e alertas ─────────────────────────────────
MONITOR_RETRY_COUNT=1
MONITOR_ALERT_FAILURE_THRESHOLD=3

# ── Credenciais E2E (use secrets no CI — nunca commite valores reais) ──
MONITOR_E2E_EMAIL=
MONITOR_E2E_PASSWORD=
