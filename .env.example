# ── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4.1-mini

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ── JWT (sessão stateless) ───────────────────────────────
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=string_aleatoria_longa_aqui

# ── Ambiente ─────────────────────────────────────────────
# development | test | production
# Fora de produção por padrão localmente; na Vercel assume production.
APP_ENV=development

# ── Credenciais do admin (SOMENTE teste/local) ───────────
# Ignoradas em APP_ENV=production — use conta com role=admin no Supabase.
# ADMIN_EMAIL aceita login simples (ex.: vinicius) ou e-mail completo.
ADMIN_EMAIL=admin@localhost.test
ADMIN_PASSWORD=
